package com.mycompany.ooponeshort;

/**
 *
 * @author ASUS
 */

// 1. The abstract parent class
abstract class Animal {
    // An abstract method has no body, just a semicolon.
    // It forces all child classes to create their own version of this method.
    public abstract void walk(); 
}

// 2. The first child class
class Horse extends Animal {
    
    @Override // Tells Java we are intentionally changing the parent's method
    public void walk() {
        System.out.println("walks on 4 legs");
    }
}

// 3. The second child class
class Chicken extends Animal {
    
    @Override
    public void walk() {
        System.out.println("Walks on 2 legs");
    }
}

// 4. The main class where the program runs
public class NewClass {
    public static void main(String[] args) {
        
        // Creating a new Horse object
        Horse horse = new Horse();
        
        // Calling the overridden walk method
        horse.walk(); 
       Animal animal = new Animal();
       animal.walk();
    }
}
