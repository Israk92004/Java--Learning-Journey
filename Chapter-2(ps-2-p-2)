public class cwh_12_ps2_pr2 {
    
    public static void main(String[] args) {
        
        char grade = '8';
        
        grade = (char)(grade + 8);
        
        System.out.println(grade);
        
        //Decrypting the grade
        
        grade = (char)(grade-8);
        System.out.println(grade);
    }
    
}
